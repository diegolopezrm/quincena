    },
    "Hands Quincena a payment or a bank's message. It waits in the inbox until you confirm it, or is recorded on its own when everything about it is clear." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pasa a Quincena un pago o un mensaje del banco. Queda en Por revisar hasta que lo confirmes, o se registra solo cuando todo está claro."
          }
        }
      }
    },
    "It is waiting in Quincena's inbox." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedó en Por revisar de Quincena."
          }
        }
      }
    },
