            "value" : "Leer comprobante"
          }
        }
      }
    },
    "Reads screenshots, photos, PDFs or texts of payments on the device and leaves them in Quincena's inbox to confirm." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee en el teléfono capturas, fotos, PDF o textos de pagos y los deja en Por revisar de Quincena para que los confirmes."
          }
        }
      }
    },
